@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar sua requisição.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID da Requisição:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de Desenvolvimento</h3>
<p>
    Alternar para o ambiente de <strong>Desenvolvimento</strong> exibirá informações detalhadas sobre o erro ocorrido.
</p>
<p>
    <strong>O ambiente de Desenvolvimento não deve ser ativado em aplicações publicadas.</strong>
    Isso pode resultar na exibição de informações sensíveis de exceções para usuários finais.
    Para depuração local, ative o ambiente de <strong>Desenvolvimento</strong> definindo a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
    e reinicie o aplicativo.
</p>
