@model List<ForumCategory>
@{
    ViewData["Title"] = "Gerenciar Fórum";
}

<section class="page-header">
    <div class="container">
        <h1>Gerenciar Fórum</h1>
        <a href="/Admin/Dashboard" class="btn btn-secondary">Voltar</a>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <h2>Categorias</h2>
        <div class="ranking-table-wrapper">
            <table class="ranking-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Ordem</th>
                        <th>Ativo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.Id</td>
                            <td>@cat.Name</td>
                            <td>@cat.Description</td>
                            <td>@cat.SortOrder</td>
                            <td>@(cat.IsActive ? "Sim" : "Não")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
