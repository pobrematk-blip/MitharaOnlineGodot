@model WikiItemsViewModel
@{
    ViewData["Title"] = "Monstros";
}

<section class="page-header">
    <div class="container">
        <h1>Monstros</h1>
        <p>Todos os monstros do Mithara Online</p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="wiki-filter-bar">
            <form method="get" action="/Wiki/Mobs" class="wiki-filter-form">
                <input type="text" name="search" value="@Model.Search" placeholder="Buscar monstro..." class="form-control wiki-filter-input" />
                <button type="submit" class="btn btn-primary">Buscar</button>
            </form>
        </div>

        @if (Model.Items.Count == 0)
        {
            <p class="empty-state">Nenhum monstro encontrado.</p>
        }
        else
        {
            <div class="wiki-mob-grid">
                @foreach (var mob in Model.Items)
                {
                    <a href="/Wiki/Mob/@mob.Id" class="wiki-mob-card">
                        <div class="wiki-mob-card-header @(mob.IsElite ? "elite" : "")">
                            <span class="wiki-mob-level">Nv. @mob.RequiredLevel</span>
                            @if (mob.IsElite)
                            {
                                <span class="wiki-mob-tag elite-tag">ELITE</span>
                            }
                        </div>
                        <div class="wiki-mob-card-body">
                            <div class="wiki-mob-avatar">@mob.Name[0]</div>
                            <h4>@mob.Name</h4>
                            <p class="text-muted">@mob.TypeName</p>
                        </div>
                    </a>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a href="/Wiki/Mobs?search=@Model.Search&page=@i" class="page-link @(i == Model.Page ? "active" : "")">@i</a>
                    }
                </div>
            }
        }
    </div>
</section>
