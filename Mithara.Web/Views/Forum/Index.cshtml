@model ForumIndexViewModel
@{
    ViewData["Title"] = "Fórum";
}

<section class="page-header">
    <div class="container">
        <h1>Fórum</h1>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="forum-categories">
            @foreach (var category in Model.Categories)
            {
                <div class="forum-category-card">
                    <div class="forum-category-header">
                        <h2><a href="/Forum/Category/@category.Id">@category.Name</a></h2>
                        <p>@category.Description</p>
                    </div>
                    <div class="forum-category-stats">
                        <span>@category.Topics.Count tópicos</span>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Categories.Any())
        {
            <p class="empty-state">Nenhuma categoria disponível.</p>
        }
    </div>
</section>
