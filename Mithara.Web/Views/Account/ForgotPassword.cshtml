@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Senha";
}

<section class="page-header">
    <div class="container">
        <h1>Recuperar Senha</h1>
    </div>
</section>

<section class="content-section">
    <div class="container container-small">
        <form asp-action="ForgotPassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (TempData["Success"] != null)
            {
                <p class="auth-note">@TempData["Success"]</p>
            }
            else
            {
                <p class="auth-note">
                    Informe seu usuario ou e-mail cadastrado. Enviaremos um link seguro para criar uma nova senha.
                </p>
            }

            <div class="form-group">
                <label asp-for="UsernameOrEmail">Usuario ou e-mail</label>
                <input asp-for="UsernameOrEmail" class="form-control" placeholder="Seu usuario ou e-mail" autofocus />
                <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Enviar Recuperacao</button>

            <p class="auth-link">Lembrou a senha? <a href="/Account/Login">Entrar</a></p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
