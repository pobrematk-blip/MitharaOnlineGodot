@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nova Senha";
}

<section class="page-header">
    <div class="container">
        <h1>Nova Senha</h1>
    </div>
</section>

<section class="content-section">
    <div class="container container-small">
        <form asp-action="ResetPassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <p class="auth-note">
                Crie uma nova senha para sua conta. Ela sera usada no site e no jogo.
            </p>

            <div class="form-group">
                <label asp-for="Password">Nova senha</label>
                <input asp-for="Password" class="form-control" placeholder="Minimo 6 caracteres" autofocus />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirmar nova senha</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repita a nova senha" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Alterar Senha</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
