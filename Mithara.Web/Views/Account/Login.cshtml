@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<section class="page-header">
    <div class="container">
        <h1>Entrar</h1>
    </div>
</section>

<section class="content-section">
    <div class="container container-small">
        <form asp-action="Login" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Username">Usuário</label>
                <input asp-for="Username" class="form-control" placeholder="Seu usuário" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Senha</label>
                <input asp-for="Password" class="form-control" placeholder="Sua senha" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group checkbox-group">
                <label>
                    <input asp-for="RememberMe" />
                    Lembrar de mim
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Entrar</button>

            <p class="auth-link">Não tem conta? <a href="/Account/Register">Cadastre-se</a></p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
