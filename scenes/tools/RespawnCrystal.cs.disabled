using Godot;

[Tool]
public partial class RespawnCrystal : Node2D
{
    [Export] public int CrystalId { get; set; } = 1;
    private bool _playerInside;
    private Control _confirmation;
    private Label _prompt;

    public override void _Ready()
    {
        AddToGroup("respawn_crystal");
        GetNodeOrNull<AnimatedSprite2D>("CrystalAnimation")?.Play("active");
        _prompt = GetNodeOrNull<Label>("InteractPrompt");
        if (_prompt != null) _prompt.Visible = false;
        if (Engine.IsEditorHint()) return;

        var area = GetNodeOrNull<Area2D>("InteractionArea");
        if (area == null) return;
        area.CollisionLayer = 0;
        area.CollisionMask = 2;
        area.BodyEntered += OnBodyEntered;
        area.BodyExited += body =>
        {
            if (body is not Player) return;
            _playerInside = false;
            if (_prompt != null) _prompt.Visible = false;
        };
    }

    private void OnBodyEntered(Node2D body)
    {
        if (_playerInside || body is not Player) return;
        _playerInside = true;
        if (_prompt != null) _prompt.Visible = true;
    }

    public bool CanInteract(Player player) =>
        _playerInside && player != null && player.GlobalPosition.DistanceSquaredTo(GlobalPosition) <= 95f * 95f;

    public bool TryInteract(Player player)
    {
        if (!CanInteract(player)) return false;
        var network = GetNodeOrNull<GameNetwork>("/root/GameNetwork");
        if (network == null || !network.IsConnected) return false;
        if (_confirmation == null || !IsInstanceValid(_confirmation))
            _confirmation = CriarConfirmacaoPadrao(network);
        _confirmation.Visible = true;
        _confirmation.MoveToFront();
        return true;
    }

    private Control CriarConfirmacaoPadrao(GameNetwork network)
    {
        var overlay = new Control { Name = "RespawnCrystalConfirmation", MouseFilter = Control.MouseFilterEnum.Stop };
        overlay.SetAnchorsAndOffsetsPreset(Control.LayoutPreset.FullRect);
        Node parent = GetTree().CurrentScene?.GetNodeOrNull<CanvasLayer>("HUD") ?? GetTree().CurrentScene;
        parent?.AddChild(overlay);

        var panel = new Panel { Size = new Vector2(460, 220) };
        panel.Position = (GetViewportRect().Size - panel.Size) * 0.5f;
        panel.AddThemeStyleboxOverride("panel", MitharaUiTheme.Panel(0.97f));
        overlay.AddChild(panel);

        var titleBar = new Panel { Size = new Vector2(460, 32) };
        titleBar.AddThemeStyleboxOverride("panel", MitharaUiTheme.TitleBar());
        panel.AddChild(titleBar);
        var title = new Label { Text = "CRISTAL DE RENASCIMENTO", Size = titleBar.Size, HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center, MouseFilter = Control.MouseFilterEnum.Ignore };
        title.AddThemeColorOverride("font_color", MitharaUiTheme.Accent);
        title.AddThemeFontSizeOverride("font_size", 16);
        titleBar.AddChild(title);

        var close = CriarBotaoFechar();
        close.Position = new Vector2(428, 4);
        close.Pressed += () => overlay.Hide();
        panel.AddChild(close);

        var message = new Label { Text = "Deseja vincular seu renascimento a este cristal?\nAo morrer, você renascerá ao lado dele.", Position = new Vector2(20, 52), Size = new Vector2(420, 86), HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center, AutowrapMode = TextServer.AutowrapMode.WordSmart };
        message.AddThemeColorOverride("font_color", MitharaUiTheme.Text);
        message.AddThemeFontSizeOverride("font_size", 15);
        panel.AddChild(message);

        var save = new Button { Text = "SALVAR NESTE CRISTAL", Position = new Vector2(38, 158), Size = new Vector2(235, 40) };
        save.Pressed += () => { overlay.Hide(); network.SendBindRespawnCrystal(CrystalId); };
        panel.AddChild(save);
        var cancel = new Button { Text = "CANCELAR", Position = new Vector2(287, 158), Size = new Vector2(135, 40) };
        cancel.Pressed += () => overlay.Hide();
        panel.AddChild(cancel);
        overlay.Resized += () => panel.Position = (overlay.Size - panel.Size) * 0.5f;
        return overlay;
    }

    private static Button CriarBotaoFechar()
    {
        var button = new Button { Text = "X", Size = new Vector2(26, 24) };
        button.AddThemeColorOverride("font_color", Colors.White);
        button.AddThemeStyleboxOverride("normal", MitharaUiTheme.Box(new Color(0.85f, 0.04f, 0.04f, 0.9f), new Color(1f, 0.25f, 0.25f), 4, 1));
        button.AddThemeStyleboxOverride("hover", MitharaUiTheme.Box(new Color(1f, 0.08f, 0.08f), new Color(1f, 0.45f, 0.45f), 4, 1));
        return button;
    }
}
