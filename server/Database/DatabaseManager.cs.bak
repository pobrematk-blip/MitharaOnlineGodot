    public List<Mithara.Server.Entities.ItemInstance> LoadItems(int characterId)
    {
        var result = new List<Mithara.Server.Entities.ItemInstance>();
        using var conn = new SqliteConnection(_connectionString);
        conn.Open();
        using var cmd = conn.CreateCommand();
        cmd.CommandText = "SELECT id, item_id, slot, quantity FROM items WHERE character_id = @c ORDER BY slot";
        cmd.Parameters.AddWithValue("@c", characterId);
        using var reader = cmd.ExecuteReader();
        while (reader.Read())
        {
            result.Add(new Mithara.Server.Entities.ItemInstance
            {
                DbId = reader.GetInt32(0),
                ItemId = reader.GetInt32(1),
                Slot = reader.GetInt32(2),
                Quantity = reader.GetInt32(3),
            });
        }
        return result;
    }

    public void SaveItem(int characterId, Mithara.Server.Entities.ItemInstance item)
    {
        using var conn = new SqliteConnection(_connectionString);
        conn.Open();
        if (item.DbId > 0)
        {
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "UPDATE items SET slot = @s, quantity = @q WHERE id = @i AND character_id = @c";
            cmd.Parameters.AddWithValue("@s", item.Slot);
            cmd.Parameters.AddWithValue("@q", item.Quantity);
            cmd.Parameters.AddWithValue("@i", item.DbId);
            cmd.Parameters.AddWithValue("@c", characterId);
            cmd.ExecuteNonQuery();
        }
        else
        {
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "INSERT INTO items (character_id, slot, item_id, quantity) VALUES (@c, @s, @ii, @q)";
            cmd.Parameters.AddWithValue("@c", characterId);
            cmd.Parameters.AddWithValue("@s", item.Slot);
            cmd.Parameters.AddWithValue("@ii", item.ItemId);
            cmd.Parameters.AddWithValue("@q", item.Quantity);
            cmd.ExecuteNonQuery();
            using var getId = conn.CreateCommand();
            getId.CommandText = "SELECT last_insert_rowid()";
            item.DbId = Convert.ToInt32(getId.ExecuteScalar());
        }
    }

