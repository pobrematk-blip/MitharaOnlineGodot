        (203.33344f,-3616f),(-1522.6667f,-3008.6667f),(-1088.6667f,-2699.3333f),(-1864.6667f,-2715.3333f),
        (-1050f,-1147.3334f),(-1652.6666f,-1060f),(-1756.0001f,-1532.6667f),(-1040f,-1538.0001f),
