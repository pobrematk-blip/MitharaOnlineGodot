using LiteNetLib;
using LiteNetLib.Utils;
using Mithara.Server.Entities;
using Mithara.Server.Packets;
using Mithara.Server.World;

namespace Mithara.Server.Network;

public partial class GameServer
{
    private const string AncientCaveDungeonId = "cavernados_ancioes";
    private const string AncientCaveDisplayName = "Caverna dos Anciões";
    private const int AncientCaveDailyLimit = 3;
    private const int AncientCaveMinGroup = 3;
    private const int AncientCaveMaxGroup = 5;
    // O portal de saída fica perto de (0, 23). A entrada/ressurreição precisa
    // ficar alguns passos para dentro da sala para não acionar o portal ao andar.
    private const float AncientCaveSpawnX = 0f;
    private const float AncientCaveSpawnY = -64f;
    private const float AncientCaveSceneScale = 1.5f;
    private const float AncientCaveExitX = 8568.667f * AncientCaveSceneScale;
    private const float AncientCaveExitY = -8740f * AncientCaveSceneScale;
    private const float AncientCaveExitUseRadius = 64f;
    private const float AncientCaveReturnFrontOffsetY = 5f;

