        (9316f,-1354f),(1388f,-2809.3333f),
    };

    private static readonly (float X, float Y) AncientZorartPosition = (8573.333f, -7204.6665f);

    private void HandleDungeonEntranceRequest(NetPeer peer, NetDataReader reader)
    {
        // O contato com o portal externo é a confirmação de que o cliente já
        // terminou de carregar a main. Permite concluir a transição de saída
        // sem depender de o jogador andar primeiro.
        if (!TryGetDungeonPlayer(peer, out var session, out var player, allowMainEntranceTransition: true)) return;

        // Recupera imediatamente a sessão antiga dessincronizada antes de
        // validar a abertura da janela de entrada.
        if (string.Equals(session.CurrentMap, AncientCaveDungeonId, StringComparison.OrdinalIgnoreCase)
            && IsAtAncientCaveEntrance(player))
        {
            session.CurrentMap = MainSceneName;
            session.DungeonInstanceId = "";
            player.DungeonInstanceId = "";
            if (session.SelectedCharacter != null)
            {
                session.SelectedCharacter.CurrentMap = MainSceneName;
                session.SelectedCharacter.PosX = player.X;
                session.SelectedCharacter.PosY = player.Y;
                _db.SaveCharacterPosition(session.SelectedCharacter.Id, player.X, player.Y, MainSceneName);
            }
            Logger.Info($"[DUNGEON] Sessão antiga de {player.Name} recuperada antes de abrir a entrada.");
        }

        if (!string.Equals(session.CurrentMap, MainSceneName, StringComparison.OrdinalIgnoreCase))
        {
            SendDungeonEnterResult(peer, false, "A entrada da dungeon só pode ser usada no mapa principal.");
            return;
        }
        if (!IsAtAncientCaveEntrance(player))
        {
            SendDungeonEnterResult(peer, false, "Aproxime-se da entrada da Caverna dos Anciões.");
            return;
        }

        int used = _db.GetDungeonEntriesUsedToday(session.SelectedCharacter!.Id, AncientCaveDungeonId);
        int partyCount = 0;
        bool isLeader = false;
        if (player.PartyId >= 0 && _world.Parties.GetParty(player.PartyId) is Party party)
        {
            partyCount = party.Members.Count;
            isLeader = party.LeaderEntityId == player.Id;
        }

        var writer = PacketSerializer.WritePacket(PacketId.S2C_DungeonEntranceData);
        writer.Put(AncientCaveDungeonId);
        writer.Put(AncientCaveDisplayName);
        writer.Put(Math.Max(0, AncientCaveDailyLimit - used));
        writer.Put(AncientCaveDailyLimit);
        writer.Put(partyCount);
        writer.Put(isLeader);
        peer.Send(writer, DeliveryMethod.ReliableOrdered);
    }

    private void HandleDungeonEnter(NetPeer peer, NetDataReader reader)
    {
        if (!TryGetDungeonPlayer(peer, out var session, out var player))
        {
            SendDungeonEnterResult(peer, false, "Não foi possível validar seu personagem. Aguarde um instante e tente novamente.");
            return;
        }
        byte requestedMode = reader.GetByte();
        var mode = requestedMode == (byte)DungeonMode.Group ? DungeonMode.Group : DungeonMode.Solo;
        Logger.Info($"[DUNGEON] Pedido de entrada: player={player.Name} modo={mode} mapa={session.CurrentMap} pos=({player.X:F1},{player.Y:F1}).");

        // Recupera sessões de versões anteriores nas quais o servidor mudou o
        // mapa para a dungeon, mas o cliente permaneceu visualmente na entrada
        // da main. A posição junto ao portal prova esse estado inconsistente.
        if (string.Equals(session.CurrentMap, AncientCaveDungeonId, StringComparison.OrdinalIgnoreCase)
            && IsAtAncientCaveEntrance(player))
        {
            session.CurrentMap = MainSceneName;
            session.DungeonInstanceId = "";
            player.DungeonInstanceId = "";
            Logger.Info($"[DUNGEON] Sessão dessincronizada de {player.Name} recuperada na entrada principal.");
        }

        if (!string.Equals(session.CurrentMap, MainSceneName, StringComparison.OrdinalIgnoreCase))
        {
            SendDungeonEnterResult(peer, false, "Você precisa estar na entrada da Caverna dos Anciões.");
            return;
        }
        if (!IsAtAncientCaveEntrance(player))
        {
            SendDungeonEnterResult(peer, false, "Você precisa estar junto ao portal da dungeon.");
            return;
        }

        if (mode == DungeonMode.Solo)
        {
            if (!CanUseDungeonEntry(session, out string error))
            {
                SendDungeonEnterResult(peer, false, error);
                return;
            }

            if (!_db.TryConsumeDungeonEntry(session.SelectedCharacter!.Id, AncientCaveDungeonId, AncientCaveDailyLimit, out _))
            {
                SendDungeonEnterResult(peer, false, "Não foi possível consumir a entrada. Atualize a janela e tente novamente.");
                return;
            }
            var instance = _world.Dungeons.Create(AncientCaveDungeonId, mode, new[] { player.Id });
            EnterDungeon(peer, session, player, instance);
            return;
        }

        if (player.PartyId < 0 || _world.Parties.GetParty(player.PartyId) is not Party party)
        {
            SendDungeonEnterResult(peer, false, "Você precisa estar em um grupo com 3 a 5 jogadores.");
            return;
        }
        if (party.LeaderEntityId != player.Id)
        {
            SendDungeonEnterResult(peer, false, "Somente o líder do grupo pode iniciar a dungeon.");
            return;
        }
        if (party.Members.Count < AncientCaveMinGroup || party.Members.Count > AncientCaveMaxGroup)
        {
            SendDungeonEnterResult(peer, false, "A entrada em grupo exige de 3 a 5 jogadores.");
            return;
        }

        var onlineMembers = new List<(NetPeer Peer, PlayerSession Session, PlayerEntity Player)>();
        foreach (ulong memberId in party.Members)
        {
            NetPeer? memberPeer = FindPeerByEntityId(memberId);
            if (memberPeer == null || !TryGetDungeonPlayer(memberPeer, out var memberSession, out var memberPlayer))
            {
                SendDungeonEnterResult(peer, false, "Todos os membros do grupo precisam estar online.");
                return;
            }
            if (!string.Equals(memberSession.CurrentMap, MainSceneName, StringComparison.OrdinalIgnoreCase))
            {
                SendDungeonEnterResult(peer, false, $"{memberPlayer.Name} não está na entrada da dungeon.");
                return;
            }
            if (!IsAtAncientCaveEntrance(memberPlayer))
            {
                SendDungeonEnterResult(peer, false, $"{memberPlayer.Name} não está junto ao portal.");
                return;
            }
            if (!CanUseDungeonEntry(memberSession, out string memberError))
            {
                SendDungeonEnterResult(peer, false, $"{memberPlayer.Name}: {memberError}");
                return;
            }
            onlineMembers.Add((memberPeer, memberSession, memberPlayer));
        }

        foreach (var member in onlineMembers)
        {
            if (!_db.TryConsumeDungeonEntry(member.Session.SelectedCharacter!.Id, AncientCaveDungeonId, AncientCaveDailyLimit, out _))
            {
                SendDungeonEnterResult(peer, false, $"Não foi possível registrar a entrada de {member.Player.Name}.");
                return;
            }
        }

        var groupInstance = _world.Dungeons.Create(
            AncientCaveDungeonId,
            mode,
            onlineMembers.Select(m => m.Player.Id),
            party.Id);
        foreach (var member in onlineMembers)
            EnterDungeon(member.Peer, member.Session, member.Player, groupInstance);
    }

    private bool TryGetDungeonPlayer(NetPeer peer, out PlayerSession session, out PlayerEntity player,
        bool allowMainEntranceTransition = false)
    {
        session = null!;
        player = null!;
        if (!_sessions.TryGetValue(peer, out var foundSession) || foundSession.SelectedCharacter == null)
            return false;
        if (foundSession.IsTransitioning)
        {
            if (!allowMainEntranceTransition
                || !string.Equals(foundSession.CurrentMap, MainSceneName, StringComparison.OrdinalIgnoreCase))
                return false;

            // A Area2D da entrada só envia este pacote depois que a main voltou
            // a existir no cliente; portanto ele funciona como ACK da troca.
            foundSession.IsTransitioning = false;
        }
        session = foundSession;
        player = _world.GetChannel(session.ChannelId)?.GetEntity(session.EntityId) as PlayerEntity ?? null!;
        return player != null && player.Health > 0;
    }

    private bool CanUseDungeonEntry(PlayerSession session, out string error)
    {
        int used = _db.GetDungeonEntriesUsedToday(session.SelectedCharacter!.Id, AncientCaveDungeonId);
        if (used >= AncientCaveDailyLimit)
        {
            error = "Você já utilizou as 3 entradas de hoje.";
            return false;
        }
        error = "";
        return true;
    }

    private bool IsAtAncientCaveEntrance(PlayerEntity player)
    {
        float dx = player.X - _config.AncientCaveEntranceX;
        float dy = player.Y - _config.AncientCaveEntranceY;
        float radius = Math.Max(32f, _config.AncientCaveEntranceRadius);
        return dx * dx + dy * dy <= radius * radius;
    }

    private void EnterDungeon(NetPeer peer, PlayerSession session, PlayerEntity player, DungeonInstance instance)
    {
        session.CurrentMap = AncientCaveDungeonId;
        session.DungeonInstanceId = instance.Id;
        session.DungeonMode = (byte)instance.Mode;
        session.SpawnedEntities.Clear();
        session.SpawnedLoot.Clear();
        session.LastTeleportTime = _gameTime;
        session.IsTransitioning = true;
        session.TransitionStartTime = _gameTime;
        player.DungeonInstanceId = instance.Id;
        var channel = _world.GetChannel(session.ChannelId);
        if (channel != null)
        {
            channel.MoveEntity(player.Id, AncientCaveSpawnX, AncientCaveSpawnY);
            EnsureAncientCaveEncounterSpawned(channel, instance);
        }
        else
        {
            player.X = AncientCaveSpawnX;
            player.Y = AncientCaveSpawnY;
        }

        if (session.SelectedCharacter != null)
        {
            session.SelectedCharacter.PosX = AncientCaveSpawnX;
            session.SelectedCharacter.PosY = AncientCaveSpawnY;
            session.SelectedCharacter.CurrentMap = AncientCaveDungeonId;
            _db.SaveCharacterPosition(session.SelectedCharacter.Id,
                AncientCaveSpawnX, AncientCaveSpawnY, AncientCaveDungeonId);
        }

        SendDungeonEnterResult(peer, true,
            instance.Mode == DungeonMode.Solo
                ? "Entrando na instancia solo."
                : "O grupo está entrando na dungeon.");
        SendSceneChange(peer, AncientCaveDungeonId, AncientCaveSpawnX, AncientCaveSpawnY);
        SendDungeonExitUnlocked(peer, instance.ExitUnlocked);
        Logger.Info($"[DUNGEON] {player.Name} entrou em {instance.Id} modo={instance.Mode}.");
    }

    private void EnsureAncientCaveEncounterSpawned(Channel channel, DungeonInstance instance)
    {
        if (instance.EncounterSpawned)
            return;

        instance.EncounterSpawned = true;
        SpawnAncientCaveMobs(channel, instance, "ancientGoblin", AncientGoblinPositions);
        SpawnAncientCaveMobs(channel, instance, "ancientGoblinElite", AncientGoblinElitePositions);
        SpawnAncientCaveMobs(channel, instance, "ancientGoblinChampion", AncientGoblinChampionPositions);
        SpawnAncientCaveMobs(channel, instance, "zorartBoss", new[] { AncientZorartPosition });
        Logger.Info($"[DUNGEON] Encontro {instance.Id}: {instance.EncounterEntityIds.Count} monstro(s), modo={instance.Mode}.");
    }

    private void SpawnAncientCaveMobs(Channel channel, DungeonInstance instance, string prefabId,
        IEnumerable<(float X, float Y)> positions)
    {
        var template = channel.Spawner.GetTemplate(prefabId);
        if (template == null)
        {
            Logger.Info($"[DUNGEON] Template ausente: {prefabId}.");
            return;
        }

        foreach (var position in positions)
        {
            var mob = channel.Spawner.CriarMonstroEm(template,
                position.X * AncientCaveSceneScale,
                position.Y * AncientCaveSceneScale);
            if (mob == null)
                continue;

            mob.DungeonInstanceId = instance.Id;
            mob.PatrolRadius = mob.IsBoss ? 720f : 480f;
            mob.AggroRange = Math.Max(mob.AggroRange, mob.IsBoss ? 960f : 760f);
            if (instance.Mode == DungeonMode.Group)
            {
                mob.Health = Math.Max(1, (int)MathF.Round(mob.Health * 3f));
                mob.MaxHealth = mob.Health;
                mob.AttackDamage = Math.Max(1, (int)MathF.Round(mob.AttackDamage * 1.35f));
                mob.Agilidade = Math.Max(1, (int)MathF.Round(mob.Agilidade * 1.35f));
                mob.MagicDefense = Math.Max(1, (int)MathF.Round(mob.MagicDefense * 1.35f));
            }

            channel.AddEntity(mob);
            instance.EncounterEntityIds.Add(mob.Id);
        }
    }

    private void HandleAncientCaveBossDefeated(Channel channel, MonsterEntity mob)
    {
        if (!string.Equals(mob.PrefabId, "zorartBoss", StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(mob.DungeonInstanceId))
            return;

        var instance = _world.Dungeons.Get(mob.DungeonInstanceId);
        if (instance == null || instance.ExitUnlocked)
            return;

        instance.ExitUnlocked = true;
        foreach (ulong memberId in instance.Members)
        {
            var memberPeer = channel.GetPlayerPeer(memberId);
            if (memberPeer != null)
                SendDungeonExitUnlocked(memberPeer, true);
        }
        Logger.Info($"[DUNGEON] Zorart derrotado em {instance.Id}; cristal de saida liberado.");
    }

    private static void SendDungeonExitUnlocked(NetPeer peer, bool unlocked)
    {
        var writer = PacketSerializer.WritePacket(PacketId.S2C_DungeonExitUnlocked);
        writer.Put(unlocked);
        peer.Send(writer, DeliveryMethod.ReliableOrdered);
    }

    private bool TryExitAncientCave(NetPeer peer, PlayerSession session, Channel channel, Entity entity, int pairId)
    {
        if (pairId != 3
            || !string.Equals(session.CurrentMap, AncientCaveDungeonId, StringComparison.OrdinalIgnoreCase))
            return false;

        var instance = _world.Dungeons.Get(session.DungeonInstanceId);
        if (instance == null || !instance.ExitUnlocked)
        {
            SendSystemMessage(peer, "Derrote Zorart para liberar o cristal de saída.");
            return true;
        }

        float dx = entity.X - AncientCaveExitX;
        float dy = entity.Y - AncientCaveExitY;
        if (dx * dx + dy * dy > AncientCaveExitUseRadius * AncientCaveExitUseRadius)
        {
            Logger.Info($"[DUNGEON] Saída ignorada para {entity.Name}: jogador não está sobre o portal.");
            return true;
        }

        string previousInstanceId = session.DungeonInstanceId;
        session.LastTeleportTime = _gameTime;
        session.IsTransitioning = true;
        session.TransitionStartTime = _gameTime;
        session.CurrentMap = MainSceneName;
        session.DungeonInstanceId = "";
        session.SpawnedEntities.Clear();
        session.SpawnedLoot.Clear();
        entity.DungeonInstanceId = "";
        if (!string.IsNullOrWhiteSpace(previousInstanceId))
            _world.Dungeons.RemoveMember(previousInstanceId, entity.Id);

        float targetX = _config.AncientCaveEntranceX;
        // A entrada da caverna e acessada de baixo para cima. Ao sair,
        // reaparece alguns pixels a frente dela, no lado externo do portal.
        float targetY = _config.AncientCaveEntranceY + AncientCaveReturnFrontOffsetY;
        channel.MoveEntity(entity.Id, targetX, targetY);

        if (session.SelectedCharacter != null)
        {
            session.SelectedCharacter.PosX = targetX;
            session.SelectedCharacter.PosY = targetY;
            session.SelectedCharacter.CurrentMap = MainSceneName;
            _db.SaveCharacterPosition(session.SelectedCharacter.Id, targetX, targetY, MainSceneName);
        }

        SendSceneChange(peer, MainSceneName, targetX, targetY);
        Logger.Info($"[DUNGEON] {entity.Name} saiu da Caverna dos Anciões pelo portal interno.");
        return true;
    }

    private static void SendDungeonEnterResult(NetPeer peer, bool success, string message)
    {
        var writer = PacketSerializer.WritePacket(PacketId.S2C_DungeonEnterResult);
        writer.Put(success);
        writer.Put(message);
        peer.Send(writer, DeliveryMethod.ReliableOrdered);
    }
}
