    private static readonly (float X, float Y)[] AncientGoblinElitePositions =
    {
        (9061.333f,-1050f),(1234f,-5551.3335f),(4825.3335f,-3376f),(9045.333f,-1614.6667f),
        (1600.0001f,-2943.3333f),(1128.6667f,-2937.3333f),(-1414.6666f,-2686.6667f),
        (-1390.6666f,-1343.3334f),(1280.6667f,-4362.667f),
    };

    private static readonly (float X, float Y)[] AncientGoblinChampionPositions =
